# =============================================================================
# Secure Banking System - Environment Configuration Template
# =============================================================================
# Design Decision: Database credentials and operational secrets must never be
# checked into version control (ISO 27001:2022 A.8.24 / A.8.28, OWASP Top 10).
#
# INSTRUCTIONS:
# 1. Copy this template to .env (which is strictly git-ignored):
#      copy .env.example .env        (Windows)
#      cp .env.example .env          (Linux/macOS)
# 2. Choose DB_TYPE='sqlite' (default zero-install) or DB_TYPE='mysql'.
# 3. If using MySQL:
#    a. Set DB_USER=root + DB_PASSWORD=<root_pw> and run: python setup_db.py
#       This creates the 'bank_app' least-privilege user automatically.
#    b. After setup, switch to DB_USER=bank_app + DB_PASSWORD=<app_pw>
#       so the running application NEVER uses root credentials.
# =============================================================================

# Database Engine Selection: 'sqlite' or 'mysql'
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite or as automatic safe fallback)
DB_PATH=banking.db

# ---------------------------------------------------------------------------
# MySQL Runtime Configuration (used when DB_TYPE=mysql)
# Run with DB_USER=bank_app after running: python setup_db.py
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=bank_app
DB_PASSWORD=
DB_NAME=secure_banking

# ---------------------------------------------------------------------------
# Least-Privilege User Setup (ISO 27001:2022 A.8.18 / A.5.15)
# Set DB_APP_PASSWORD before running: python setup_db.py
# setup_db.py creates 'bank_app'@'localhost' with SELECT, INSERT, UPDATE only.
# After setup, set DB_USER=bank_app and DB_PASSWORD to the same value below.
# ---------------------------------------------------------------------------
DB_APP_PASSWORD=
