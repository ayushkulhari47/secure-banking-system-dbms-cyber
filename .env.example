# =============================================================================
# Secure Banking System - Environment Configuration Template
# =============================================================================
# Copy this template to .env (which is git-ignored) and replace placeholders
# with your environment-specific values. Never commit real credentials.
# =============================================================================

# Database Engine Selection: 'sqlite' or 'mysql'
DB_TYPE=sqlite

# SQLite Configuration (used only when DB_TYPE=sqlite)
DB_PATH=banking.db

# ---------------------------------------------------------------------------
# MySQL Configuration (used when DB_TYPE=mysql)
# All MySQL settings must be provided explicitly; there are no default credentials.
# ---------------------------------------------------------------------------
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# ---------------------------------------------------------------------------
# Optional MySQL Provisioning Credentials (used only by setup_db.py)
# ---------------------------------------------------------------------------
DB_ADMIN_USER=your_mysql_admin_user
DB_ADMIN_PASSWORD=your_mysql_admin_password
DB_APP_PASSWORD=your_app_user_password

# ---------------------------------------------------------------------------
# Optional Demo Seeding Passwords (used only by scripts/seed_demo.py)
# If omitted, scripts/seed_demo.py prompts securely via getpass.
# ---------------------------------------------------------------------------
DEMO_ADMIN_PASSWORD=your_demo_admin_password
DEMO_RAHUL_PASSWORD=your_demo_user1_password
DEMO_PRIYA_PASSWORD=your_demo_user2_password
